---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Zugangspläne"
  description="Die Zugangspläne von AHoosh für Daten und Recherchen sind in Entwicklung. Für Beratung, Recherche oder Datenunterstützung kontaktieren Sie AHoosh direkt."
>

  <section style="background:linear-gradient(160deg,#03142E 0%,#010A18 100%);padding:130px 24px 80px;text-align:center;min-height:60vh;display:flex;align-items:center;">
    <div style="max-width:540px;margin:0 auto;">
      <div class="section-eyebrow" style="margin-bottom:14px;">Zugangspläne</div>
      <h1 style="font-family:var(--font-head);font-weight:700;font-size:clamp(24px,5vw,36px);color:var(--silver);margin:0 0 20px;line-height:1.3;">
        Kommt später
      </h1>
      <p style="font-size:15px;color:var(--silver-dim);line-height:1.8;margin-bottom:32px;">
        AHoosh entwickelt derzeit sein Modell für den Zugang zu Daten und Recherchen.
        Die Preise sind noch nicht öffentlich.
      </p>
      <p style="font-size:14px;color:var(--silver-dim);line-height:1.7;margin-bottom:36px;">
        Für Beratung, Recherche oder individuelle Datenunterstützung
        wenden Sie sich bitte direkt an AHoosh.
      </p>
      <a href="/de/contact" class="btn-primary" style="display:inline-block;min-width:220px;">AHoosh kontaktieren</a>
    </div>
  </section>

</BaseLayout>
